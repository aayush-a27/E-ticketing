# ---------------------------------------------------------------------------
# CineReserve backend environment
# Copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- Database ---------------------------------------------------------------
# Transactions require a replica set.
# Atlas gives you one; locally run: mongod --replSet rs0  then  rs.initiate()
MONGODB_URI=mongodb://127.0.0.1:27017/cinereserve?replicaSet=rs0
# Legacy database, only read by scripts/migrateLegacyUsers.js
LEGACY_MONGODB_URI=mongodb://127.0.0.1:27017/userSignupDets

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-64-byte-random-hex-string
JWT_REFRESH_SECRET=replace-me-with-a-different-64-byte-random-hex-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
BCRYPT_ROUNDS=12

# --- Cookies ----------------------------------------------------------------
# In production set COOKIE_SECURE=true and COOKIE_SAME_SITE=none when the
# frontends are served from a different origin than the API.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (credentials are sent).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Rate limiting ----------------------------------------------------------
# In-memory store: counters are per process and are NOT shared between
# instances. See README before running more than one copy of the server.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=300
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_SENSITIVE_MAX=30
# Ticket scanning at the door. A venue admits its whole audience in a short
# burst, so this is far higher than the sensitive limit above.
RATE_LIMIT_GATE_MAX=600

# How many minutes before a show the gate starts admitting its tickets. A scan
# outside the window is refused and the ticket is NOT spent.
GATE_OPENS_MINUTES_BEFORE=90

# --- Super admin bootstrap --------------------------------------------------
# Read only by scripts/bootstrapSuperAdmin.js. Remove after the first run.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

# --- Notifications ----------------------------------------------------------
# console = write to the log (no provider, no cost). Real providers plug in
# behind the same interface later.
# console prints emails to the server log; smtp sends them for real.
NOTIFICATION_TRANSPORT=console
# Where links in emails point - the customer site.
APP_PUBLIC_URL=http://localhost:5173

# Needed only with NOTIFICATION_TRANSPORT=smtp. Free options:
#   Gmail  smtp.gmail.com, port 587, your address + an App Password
#   Brevo  smtp-relay.brevo.com, port 587, login + key from SMTP & API
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Send each email as soon as it is queued (the outbox still retries failures).
NOTIFICATION_DELIVER_IMMEDIATELY=true

# --- Payments ---------------------------------------------------------------
# memory   = simulated gateway; no account, no cost. Signs with the same HMAC
#            construction as Razorpay, so the verification code is the real one.
# razorpay = live or test mode; needs the values below. Test keys are free.
PAYMENT_PROVIDER=memory
RAZORPAY_KEY_ID=
# Never sent to a browser: order creation and signature checks are server-side.
RAZORPAY_KEY_SECRET=
# Set this in the Razorpay dashboard when you add the webhook endpoint.
RAZORPAY_WEBHOOK_SECRET=

# --- Tickets ----------------------------------------------------------------
# Signs QR ticket tokens. Must differ from the JWT secrets so a ticket can
# never be mistaken for a session.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TICKET_TOKEN_SECRET=replace-me-with-a-64-byte-random-hex-string

# --- Background jobs --------------------------------------------------------
# How often lapsed seat holds are swept up, and how often abandoned bookings,
# pending refunds and queued notifications are reconciled.
SEAT_HOLD_SWEEP_INTERVAL_MS=30000
RECONCILE_INTERVAL_MS=60000

# --- Image storage ----------------------------------------------------------
# memory   = in-process store; no account, no cost, nothing leaves the machine.
#            Uploads are simulated, so use it for local work and tests only.
# cloudinary = real storage; needs all three values below (free tier is enough).
MEDIA_PROVIDER=memory
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# Never exposed to a browser: uploads are signed server-side.
CLOUDINARY_API_SECRET=

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
