# ---------------------------------------------------------------------------
# CineReserve backend environment
# Copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- Database ---------------------------------------------------------------
# Transactions require a replica set.
# Atlas gives you one; locally run: mongod --replSet rs0  then  rs.initiate()
MONGODB_URI=mongodb://127.0.0.1:27017/cinereserve?replicaSet=rs0
# Legacy database, only read by scripts/migrateLegacyUsers.js
LEGACY_MONGODB_URI=mongodb://127.0.0.1:27017/userSignupDets

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-64-byte-random-hex-string
JWT_REFRESH_SECRET=replace-me-with-a-different-64-byte-random-hex-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
BCRYPT_ROUNDS=12

# --- Cookies ----------------------------------------------------------------
# In production set COOKIE_SECURE=true and COOKIE_SAME_SITE=none when the
# frontends are served from a different origin than the API.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (credentials are sent).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Rate limiting ----------------------------------------------------------
# In-memory store: counters are per process and are NOT shared between
# instances. See README before running more than one copy of the server.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=300
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_SENSITIVE_MAX=30

# --- Super admin bootstrap --------------------------------------------------
# Read only by scripts/bootstrapSuperAdmin.js. Remove after the first run.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=

# --- Notifications ----------------------------------------------------------
# console = write to the log (no provider, no cost). Real providers plug in
# behind the same interface later.
NOTIFICATION_TRANSPORT=console
APP_PUBLIC_URL=http://localhost:5173

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=info
