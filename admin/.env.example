# ---------------------------------------------------------------------------
# CineReserve admin console
# Copy to .env.local and adjust. Everything here ships to the browser, so it
# must never hold a secret.
# ---------------------------------------------------------------------------

# Leave empty in development: Vite proxies /api to the backend on port 4000,
# which keeps the session cookie same-origin. Set the full API origin in
# production, e.g. https://api.cinereserve.example
VITE_API_BASE_URL=
